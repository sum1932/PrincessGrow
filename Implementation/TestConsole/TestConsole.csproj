    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DessertKingdom.TestConsole</RootNamespace>
    <AssemblyName>DessertKingdom.TestConsole</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Simulation\Simulation.csproj" />
    <PackageReference Include="OpenAI" Version="1.11.0" />
    <PackageReference Include="Google.GenAI" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
